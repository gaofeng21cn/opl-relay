#!/usr/bin/env python3
"""Run the Relay engine from the installed Plugin carrier."""

from __future__ import annotations

import runpy
import sys
from pathlib import Path


PACKAGE_ROOT = Path(__file__).resolve().parents[1]
RUNTIME_ROOT = PACKAGE_ROOT / "runtime"

if not RUNTIME_ROOT.is_dir():
    raise SystemExit("opl-relay: installed package runtime is unavailable")

sys.path.insert(0, str(RUNTIME_ROOT))
runpy.run_module("codex_mail_workbench.cli", run_name="__main__")
